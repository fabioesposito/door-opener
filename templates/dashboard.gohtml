<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <title>Dashboard</title>
    <style>
        .toast {
            visibility: hidden;
            min-width: 250px;
            margin-left: -125px;
            background-color: #333;
            color: #fff;
            text-align: center;
            border-radius: 2px;
            padding: 16px;
            position: fixed;
            z-index: 1;
            left: 50%;
            bottom: 30px;
            font-size: 17px;
        }

        .toast.show {
            visibility: visible;
            -webkit-animation: fadein 0.5s, fadeout 0.5s 2.5s;
            animation: fadein 0.5s, fadeout 0.5s 2.5s;
        }

        @-webkit-keyframes fadein {
            from {bottom: 0; opacity: 0;}
            to {bottom: 30px; opacity: 1;}
        }

        @keyframes fadein {
            from {bottom: 0; opacity: 0;}
            to {bottom: 30px; opacity: 1;}
        }

        @-webkit-keyframes fadeout {
            from {bottom: 30px; opacity: 1;}
            to {bottom: 0; opacity: 0;}
        }

        @keyframes fadeout {
            from {bottom: 30px; opacity: 1;}
            to {bottom: 0; opacity: 0;}
        }
    </style>
</head>
<body class="bg-gray-100 flex items-center justify-center h-screen">
    <div class="bg-white p-8 rounded-lg shadow-md w-full max-w-sm text-center">
        <h1 class="text-2xl font-bold mb-6">Welcome to your Dashboard!</h1>
        <button id="doorbellButton"
                class="w-full bg-green-500 text-white py-3 px-6 rounded-full text-lg font-semibold hover:bg-green-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500">
            Doorbell
        </button>
    </div>

    <div id="toaster" class="toast"></div>

    <script>
        document.getElementById('doorbellButton').addEventListener('click', async () => {
            const toaster = document.getElementById('toaster');
            toaster.className = 'toast'; // Reset classes
            toaster.style.backgroundColor = ''; // Reset background color

            try {
                const response = await fetch('/api/doorbell', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });

                if (response.ok) {
                    toaster.style.backgroundColor = '#4CAF50'; // Green
                    toaster.textContent = 'Doorbell triggered successfully!';
                } else {
                    const errorText = await response.text();
                    toaster.style.backgroundColor = '#f44336'; // Red
                    toaster.textContent = `Error: ${errorText}`;
                }
            } catch (error) {
                toaster.style.backgroundColor = '#f44336'; // Red
                toaster.textContent = `Network Error: ${error.message}`;
            }

            toaster.classList.add('show');
            setTimeout(() => {
                toaster.classList.remove('show');
            }, 3000); // Hide after 3 seconds
        });
    </script>
</body>
</html>